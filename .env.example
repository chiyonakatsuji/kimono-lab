# Copy this file to `.env` and fill in ONE of the two options below.
# `.env` is gitignored — never commit real tokens.

# ─── Option 1 (recommended): Behold.so ────────────────────────────────────────
# Behold owns the Meta app and refreshes the access token for you, so the feed
# does not silently die every 60 days.
#
#   1. Sign up at https://behold.so (free tier covers one account)
#   2. Connect the @kimonolab_ Instagram account when prompted
#   3. Create a feed, then copy its JSON endpoint URL here
#
BEHOLD_FEED_URL=

# ─── Option 2: Instagram Graph API directly ───────────────────────────────────
# No third party, no cost, but the token expires every 60 days and Meta revises
# this API roughly twice a year. Only use this if you are willing to maintain it.
#
#   1. The account must be an Instagram Business or Creator account
#   2. Create an app at https://developers.facebook.com
#   3. Add "Instagram" and generate a token with `instagram_business_basic`
#
IG_USER_ID=
IG_ACCESS_TOKEN=

# ─── Filtering ────────────────────────────────────────────────────────────────
# Only sync posts carrying this hashtag. STRONGLY recommended: without it,
# every post becomes a product, including pop-up and event announcements.
# Ask your mother to add one tag to garment posts, e.g. #kimonolab_piece
IG_REQUIRED_TAG=

# How many recent posts to look at.
IG_MAX_POSTS=24
