# Copy this file to `.env` and fill in ONE of the two options below.
# `.env` is gitignored — never commit real tokens.
#
# The deployed site reads the same variables from GitHub Actions secrets and
# variables, not from this file. Set those with `gh secret set NAME` (it prompts
# for the value without echoing it) or in Settings → Secrets and variables →
# Actions. A token pasted into a file or a commit has to be treated as leaked.

# ─── Option 1 (recommended): Behold.so ────────────────────────────────────────
# Behold owns the Meta app and refreshes the access token for you, so the feed
# does not silently die every 60 days.
#
#   1. Sign up at https://behold.so (free plan: one source, one feed)
#   2. Sources → "+ Add source" → Basic source, and authorise @kimonolab_.
#      Instagram must be a Business or Creator account; Meta stopped allowing
#      personal accounts in December 2024.
#   3. "+ Add Feed" → output JSON → copy the feed URL (https://feeds.behold.so/…)
#
# Free plan caps a feed at its 6 most recent posts and refreshes it once a day,
# so IG_MAX_POSTS below cannot raise it past 6 and a garment tagged further back
# than six posts will not appear.
#
BEHOLD_FEED_URL=

# ─── Option 2: Instagram Graph API directly ───────────────────────────────────
# No third party, no cost, but the token expires every 60 days and Meta revises
# this API roughly twice a year. Only use this if you are willing to maintain it.
#
#   1. The account must be an Instagram Business or Creator account
#   2. Create an app at https://developers.facebook.com
#   3. Add "Instagram" and generate a token with `instagram_business_basic`
#
IG_USER_ID=
IG_ACCESS_TOKEN=

# ─── Filtering ────────────────────────────────────────────────────────────────
# Only sync posts carrying this hashtag. STRONGLY recommended: without it,
# every post becomes a product, including pop-up and event announcements.
# Ask your mother to add one tag to garment posts, e.g. #kimonolab_piece
IG_REQUIRED_TAG=

# How many recent posts to look at. A Behold free feed returns 6 whatever this
# says; the Graph API honours it.
IG_MAX_POSTS=24

# ─── CI only ──────────────────────────────────────────────────────────────────
# Set by .github/workflows/deploy.yml, and deliberately NOT set here: it turns a
# failed sync into a warning so a dead feed cannot take the published site down.
# Leave it unset locally so `npm run sync` still exits 1 on a real error.
# SYNC_ALLOW_FAILURE=1
