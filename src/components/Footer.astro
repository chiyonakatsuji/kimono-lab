---
import { useTranslations, path, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<!-- The egret artwork is deliberately not here: the PNG has a border baked
     into it, and until it is re-exported cleanly, empty space reads better. -->
<footer class="mx-auto max-w-[88rem] w-full px-8 sm:px-14 pt-40 pb-16">
  <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-10">
    <div>
      <p class="text-sm tracking-[0.34em] text-sumi uppercase">Kimono.Lab</p>
      <p class="label mt-4">{t('site.tagline')}</p>
    </div>

    <nav aria-label="Footer" class="flex gap-8">
      <a href={path(lang, 'pieces')} class="label hover:text-sumi transition-colors"
        >{t('nav.pieces')}</a
      >
      <a href={path(lang, 'about')} class="label hover:text-sumi transition-colors"
        >{t('nav.about')}</a
      >
      <a href={path(lang, 'contact')} class="label hover:text-sumi transition-colors"
        >{t('nav.contact')}</a
      >
    </nav>

    <p class="label">© {year} KIMONO.LAB</p>
  </div>
</footer>
