---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, path, type Lang } from '../i18n/ui';

interface Props {
  piece: CollectionEntry<'pieces'>;
  lang: Lang;
  /** The first card on a page carries the largest image; don't lazy-load it. */
  eager?: boolean;
}

const { piece, lang, eager = false } = Astro.props;
const t = useTranslations(lang);
const text = piece.data[lang];
const prov = piece.data.provenance;
---

<a href={path(lang, 'pieces', piece.id)} class="group block">
  <Image
    src={piece.data.photo}
    alt={text.alt}
    widths={[420, 760, 1100]}
    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
    class="w-full h-auto bg-paper-dim"
    loading={eager ? 'eager' : 'lazy'}
  />

  <div class="mt-7">
    <h3 class="text-base text-sumi group-hover:text-ai transition-colors">
      {text.name}
    </h3>
    {prov && <p class="label mt-2">{prov.cloth[lang]}</p>}
    {
      !piece.data.available && (
        <p class="label mt-2 text-ink-soft/70">{t('piece.status.sold')}</p>
      )
    }
  </div>
</a>
