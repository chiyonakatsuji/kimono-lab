---
import { Image } from 'astro:assets';
import wordmark from '../assets/logo-wordmark.png';
import { useTranslations, path, withBase, stripBase, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'ja' ? 'en' : 'ja';

const pathname = stripBase(Astro.url.pathname);

// Keep the visitor on the same page when they switch language.
const samePageOtherLang = withBase(`/${other}${pathname.replace(/^\/(ja|en)/, '')}`);

const links = [
  { href: path(lang, 'pieces'), label: t('nav.pieces') },
  { href: path(lang, 'about'), label: t('nav.about') },
  { href: path(lang, 'contact'), label: t('nav.contact') },
];

const current = withBase(pathname).replace(/\/$/, '');
---

<!-- No bottom border: the space below does the separating.
     `w-full` matters: body is a flex column, and `mx-auto` alone would cancel
     the default stretch and shrink the header to its content width. -->
<header class="mx-auto max-w-[88rem] w-full px-8 sm:px-14 pt-10 pb-16 sm:pt-14">
  <div class="flex items-center justify-between gap-8">
    <a href={path(lang)} class="shrink-0">
      {/* logo-wordmark.png was converted from black-on-white to a true alpha
          mask, so it sits on the paper colour with no grey box behind it. */}
      <Image
        src={wordmark}
        alt="KIMONO.LAB JAPAN"
        widths={[240, 480]}
        sizes="240px"
        class="h-9 sm:h-11 w-auto"
        loading="eager"
      />
      <span class="sr-only">— {t('site.tagline')}</span>
    </a>

    <nav aria-label="Main" class="flex items-center gap-7 sm:gap-11">
      {
        links.map((link) => {
          const active = current === link.href.replace(/\/$/, '');
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'label transition-colors hover:text-sumi',
                active && 'text-sumi',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }

      <a
        href={samePageOtherLang}
        hreflang={other}
        class="label transition-colors hover:text-sumi"
      >
        {other === 'ja' ? 'JA' : 'EN'}
      </a>
    </nav>
  </div>
</header>
