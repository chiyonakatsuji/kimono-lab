---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  alt: string;
  photo: ImageMetadata;
  gallery: ImageMetadata[];
}

const { lang, alt, photo, gallery } = Astro.props;
const t = useTranslations(lang);
const views = [photo, ...gallery];
const interactive = views.length > 1;
---

{
  interactive ? (
    <div class="piece-photos" data-piece-photos>
      <div
        class="piece-photos__stage"
        tabindex="0"
        role="region"
        aria-roledescription="carousel"
        aria-label={t('piece.photos')}
      >
        {views.map((img, i) => (
          <div
            class:list={['piece-photos__slide', i === 0 && 'is-current']}
            data-photo-slide
            aria-hidden={i === 0 ? undefined : 'true'}
          >
            <Image
              src={img}
              alt={alt}
              widths={[720, 1100, 1600]}
              sizes="(min-width: 1024px) 55vw, 100vw"
              class="piece-photos__img"
              loading="eager"
            />
          </div>
        ))}
      </div>

      <div class="piece-photos__thumbs" style={`--thumbs: ${Math.min(views.length, 4)}`}>
        {views.map((img, i) => (
          <button
            type="button"
            class="piece-photos__thumb"
            data-photo-index={String(i)}
            aria-label={`${t('piece.showPhoto')} ${i + 1} / ${views.length}`}
            aria-current={i === 0 ? 'true' : undefined}
          >
            <Image
              src={img}
              alt=""
              widths={[320, 640]}
              sizes="22vw"
              class="photo-frame"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </button>
        ))}
      </div>
    </div>
  ) : (
    <Image
      src={photo}
      alt={alt}
      widths={[720, 1100, 1600]}
      sizes="(min-width: 1024px) 55vw, 100vw"
      class="w-full h-auto bg-paper-dim"
      loading="eager"
    />
  )
}

{
  interactive && (
    <script is:inline>
      (function () {
        var roots = document.querySelectorAll('[data-piece-photos]');
        for (var r = 0; r < roots.length; r++) bind(roots[r]);

        function bind(root) {
          if (root.getAttribute('data-bound')) return;
          root.setAttribute('data-bound', '1');

          var stage = root.querySelector('.piece-photos__stage');
          var slides = root.querySelectorAll('[data-photo-slide]');
          var thumbs = root.querySelectorAll('[data-photo-index]');
          if (!stage || slides.length < 2) return;

          var index = 0;
          var startX = 0;
          var startY = 0;
          var tracking = false;

          function show(next) {
            var n = slides.length;
            index = ((next % n) + n) % n;
            for (var i = 0; i < slides.length; i++) {
              slides[i].classList.toggle('is-current', i === index);
              if (i === index) {
                slides[i].removeAttribute('aria-hidden');
              } else {
                slides[i].setAttribute('aria-hidden', 'true');
              }
            }
            for (var t = 0; t < thumbs.length; t++) {
              if (t === index) thumbs[t].setAttribute('aria-current', 'true');
              else thumbs[t].removeAttribute('aria-current');
            }
          }

          for (var t = 0; t < thumbs.length; t++) {
            thumbs[t].addEventListener('click', function (e) {
              var btn = e.currentTarget;
              var i = parseInt(btn.getAttribute('data-photo-index'), 10);
              if (!isNaN(i)) show(i);
            });
          }

          stage.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowRight') {
              e.preventDefault();
              show(index + 1);
            } else if (e.key === 'ArrowLeft') {
              e.preventDefault();
              show(index - 1);
            }
          });

          stage.addEventListener('pointerdown', function (e) {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            startX = e.clientX;
            startY = e.clientY;
            tracking = true;
            try {
              stage.setPointerCapture(e.pointerId);
            } catch (err) {}
          });

          stage.addEventListener('pointerup', function (e) {
            if (!tracking) return;
            tracking = false;
            var dx = e.clientX - startX;
            var dy = e.clientY - startY;
            if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
              show(index + (dx < 0 ? 1 : -1));
            }
          });
        }
      })();
    </script>
  )
}
