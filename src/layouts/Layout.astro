---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, withBase, stripBase, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);

const fullTitle = title ? `${title}｜KIMONO.LAB` : `KIMONO.LAB — ${t('site.tagline')}`;
const pathWithoutLang = stripBase(Astro.url.pathname).replace(/^\/(ja|en)/, '');
const introMp4 = withBase('/intro.mp4');
const introWebm = withBase('/intro.webm');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(withBase(stripBase(Astro.url.pathname)), Astro.site)} />

    <meta property="og:site_name" content="KIMONO.LAB" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />

    <!-- Tell search engines the two languages are the same site. -->
    <link rel="alternate" hreflang="ja" href={new URL(withBase(`/ja${pathWithoutLang}`), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(withBase(`/en${pathWithoutLang}`), Astro.site)} />

    <!-- Two families only: mincho for reading, a quiet sans for small labels. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500&family=Zen+Kaku+Gothic+New:wght@400&display=swap"
    />

    <!-- Gate the intro before first paint so the page does not flash, then
         overlay, on a cold visit — and so later loads skip it instantly. -->
    <script is:inline>
      (function () {
        try {
          if (
            sessionStorage.getItem('kimono-lab.intro') ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            document.documentElement.dataset.intro = 'done';
          } else {
            document.documentElement.dataset.intro = 'pending';
          }
        } catch (e) {
          document.documentElement.dataset.intro = 'done';
        }
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <div
      id="site-intro"
      class="site-intro"
      data-mp4={introMp4}
      data-webm={introWebm}
      aria-hidden="true"
    >
      <video muted playsinline disablepictureinpicture disableremoteplayback></video>
      <button type="button" class="site-intro__skip">{t('intro.skip')}</button>
    </div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-sumi focus:text-paper focus:px-4 focus:py-2"
    >
      {t('skip')}
    </a>

    <Header lang={lang} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />

    <script is:inline>
      (function () {
        var KEY = 'kimono-lab.intro';

        function shouldSkip() {
          try {
            return !!(
              sessionStorage.getItem(KEY) ||
              window.matchMedia('(prefers-reduced-motion: reduce)').matches
            );
          } catch (e) {
            return true;
          }
        }

        function bootIntro() {
          var overlay = document.getElementById('site-intro');
          if (!overlay) return;

          if (shouldSkip()) {
            document.documentElement.dataset.intro = 'done';
            overlay.remove();
            return;
          }

          if (overlay.getAttribute('data-bound')) return;
          overlay.setAttribute('data-bound', '1');
          document.documentElement.dataset.intro = 'pending';

          var video = overlay.querySelector('video');
          if (!video) {
            overlay.remove();
            return;
          }

          var settled = false;
          var started = false;
          var fadeMs = 900;
          var startGuard;
          var safetyTimer;

          function markDone() {
            try {
              sessionStorage.setItem(KEY, '1');
            } catch (e) {}
            document.documentElement.dataset.intro = 'done';
          }

          function cleanupVideo() {
            video.pause();
            video.removeAttribute('src');
            video.load();
          }

          function onKey(e) {
            if (e.key === 'Escape') dismiss();
          }

          function dismiss() {
            if (settled) return;
            settled = true;
            markDone();
            clearTimeout(startGuard);
            clearTimeout(safetyTimer);
            document.removeEventListener('keydown', onKey);
            overlay.classList.add('is-leaving');
            var finished = false;
            function done() {
              if (finished) return;
              finished = true;
              cleanupVideo();
              overlay.remove();
            }
            overlay.addEventListener('transitionend', done);
            setTimeout(done, fadeMs);
          }

          var skip = overlay.querySelector('.site-intro__skip');
          if (skip) {
            skip.addEventListener('click', function (e) {
              e.preventDefault();
              e.stopPropagation();
              dismiss();
            });
          }
          document.addEventListener('keydown', onKey);
          video.addEventListener('ended', dismiss);
          video.addEventListener('error', dismiss);
          video.addEventListener('playing', function () {
            started = true;
          });
          video.addEventListener('loadedmetadata', function () {
            var ms = Math.ceil((video.duration || 12) * 1000) + 2500;
            safetyTimer = setTimeout(function () {
              if (!settled) dismiss();
            }, ms);
          });

          startGuard = setTimeout(function () {
            if (!started) dismiss();
          }, 1800);

          var webm = overlay.getAttribute('data-webm');
          var mp4 = overlay.getAttribute('data-mp4');
          if (webm && video.canPlayType('video/webm; codecs="vp9"')) {
            video.src = webm;
          } else if (mp4) {
            video.src = mp4;
          } else {
            dismiss();
            return;
          }

          video.muted = true;
          video.playsInline = true;
          var playAttempt = video.play();
          if (playAttempt && playAttempt.catch) {
            playAttempt.catch(function () {
              dismiss();
            });
          }
        }

        bootIntro();
        document.addEventListener('astro:page-load', bootIntro);
      })();
    </script>
  </body>
</html>
