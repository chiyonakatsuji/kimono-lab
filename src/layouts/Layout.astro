---
import fs from 'node:fs';
import path from 'node:path';
import '../styles/global.css';
import { Image } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import monogram from '../assets/logo-monogram.png';
import wordmark from '../assets/logo-wordmark.png';
import { useTranslations, withBase, stripBase, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);

// Landscape slot: drop a muted clip at public/intro-landscape.mp4 (optional .webm).
// Until that file exists the intro is paper + lockup only — no stock Kyoto.
const introPublicDir = path.join(process.cwd(), 'public');
const introMp4Exists = fs.existsSync(path.join(introPublicDir, 'intro-landscape.mp4'));
const introWebmExists = fs.existsSync(path.join(introPublicDir, 'intro-landscape.webm'));
const hasIntroLandscape = introMp4Exists || introWebmExists;
const introMp4Src = withBase('/intro-landscape.mp4');
const introWebmSrc = withBase('/intro-landscape.webm');

const fullTitle = title ? `${title}｜KIMONO.LAB` : `KIMONO.LAB — ${t('site.tagline')}`;
const pathWithoutLang = stripBase(Astro.url.pathname).replace(/^\/(ja|en)/, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(withBase(stripBase(Astro.url.pathname)), Astro.site)} />

    <meta property="og:site_name" content="KIMONO.LAB" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />

    <!-- Tell search engines the two languages are the same site. -->
    <link rel="alternate" hreflang="ja" href={new URL(withBase(`/ja${pathWithoutLang}`), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(withBase(`/en${pathWithoutLang}`), Astro.site)} />

    <!-- Two families only: mincho for reading, a quiet sans for small labels. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500&family=Zen+Kaku+Gothic+New:wght@400&display=swap"
    />

    <!-- Gate the intro before first paint so the page does not flash, then
         overlay, on a cold visit — and so later loads skip it instantly. -->
    <script is:inline>
      (function () {
        try {
          if (
            sessionStorage.getItem('kimono-lab.intro') ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            document.documentElement.dataset.intro = 'done';
          } else {
            document.documentElement.dataset.intro = 'pending';
          }
        } catch (e) {
          document.documentElement.dataset.intro = 'done';
        }
      })();
    </script>
    <style is:inline>
      html[data-intro='pending'] {
        overflow: hidden;
      }
      html[data-intro='pending'] .site-intro {
        display: flex;
        position: fixed;
        inset: 0;
        z-index: 200;
        align-items: center;
        justify-content: center;
        background-color: #fbfaf8;
      }
      html[data-intro='pending'] .site-intro__landscape {
        position: absolute;
        inset: 0;
      }
      html[data-intro='pending'] .site-intro__video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }
      html[data-intro='pending'] .site-intro__kl,
      html[data-intro='pending'] .site-intro__word {
        opacity: 0;
      }
    </style>
  </head>

  <body class="min-h-screen flex flex-col">
    <!-- Intro sequence (Toraya-like, owned footage only):
         1) 2–4s muted landscape, object-fit cover, full viewport
         2) crossfade to paper #fbfaf8
         3) existing KL → wordmark, hold, overlay fade
         Drop-in: public/intro-landscape.mp4 (and optional .webm).
         Clip: 3–6s usable, landscape 16:9 or wider, 720p/1080p H.264 +faststart,
         muted, quiet Japanese garden / architecture / season — not 9:16, not
         a travel vlog, not clothes_animation2 / KIMONO.LAB.mp4. -->
    <div
      id="site-intro"
      class:list={['site-intro', hasIntroLandscape ? 'is-landscape' : 'is-paper']}
    >
      {
        hasIntroLandscape && (
          <div class="site-intro__landscape" aria-hidden="true">
            <video
              class="site-intro__video"
              muted
              playsinline
              preload="auto"
              disablepictureinpicture
            >
              {introWebmExists && <source src={introWebmSrc} type="video/webm" />}
              {introMp4Exists && <source src={introMp4Src} type="video/mp4" />}
            </video>
          </div>
        )
      }
      <div class="site-intro__mark" aria-hidden="true">
        <Image
          src={monogram}
          alt=""
          widths={[168, 336]}
          sizes="168px"
          class="site-intro__kl"
          loading="eager"
          decoding="sync"
        />
        <Image
          src={wordmark}
          alt=""
          widths={[480, 960]}
          sizes="(min-width: 640px) 22rem, 16rem"
          class="site-intro__word"
          loading="eager"
          decoding="sync"
        />
      </div>
      <button type="button" class="site-intro__skip">{t('intro.skip')}</button>
    </div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-sumi focus:text-paper focus:px-4 focus:py-2"
    >
      {t('skip')}
    </a>

    <Header lang={lang} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />

    <script is:inline>
      (function () {
        var KEY = 'kimono-lab.intro';
        var HOLD_MS = 3400;
        var FADE_MS = 700;
        var PAPER_FADE_MS = 900;
        var LANDSCAPE_MAX_MS = 4000;
        var LANDSCAPE_DEFAULT_MS = 3200;
        var VIDEO_FAIL_MS = 1800;
        var SAFETY_MS = 11000;

        function shouldSkip() {
          try {
            return !!(
              sessionStorage.getItem(KEY) ||
              window.matchMedia('(prefers-reduced-motion: reduce)').matches
            );
          } catch (e) {
            return true;
          }
        }

        function bootIntro() {
          var overlay = document.getElementById('site-intro');
          if (!overlay) return;

          if (shouldSkip()) {
            document.documentElement.dataset.intro = 'done';
            overlay.remove();
            return;
          }

          if (overlay.getAttribute('data-bound')) return;
          overlay.setAttribute('data-bound', '1');
          document.documentElement.dataset.intro = 'pending';

          var settled = false;
          var paperStarted = false;
          var landscapePlayed = false;
          var holdTimer;
          var safetyTimer;
          var landscapeTimer;
          var failTimer;
          var video = overlay.querySelector('.site-intro__video');

          function markDone() {
            try {
              sessionStorage.setItem(KEY, '1');
            } catch (e) {}
            document.documentElement.dataset.intro = 'done';
          }

          function stopVideo() {
            if (!video) return;
            try {
              video.pause();
            } catch (e) {}
            try {
              video.removeAttribute('src');
              var sources = video.querySelectorAll('source');
              for (var i = 0; i < sources.length; i++) sources[i].remove();
              video.load();
            } catch (e) {}
            if (video.parentNode) video.parentNode.remove();
            video = null;
          }

          function onKey(e) {
            if (e.key === 'Escape') dismiss();
          }

          function dismiss() {
            if (settled) return;
            settled = true;
            overlay.classList.add('is-leaving');
            markDone();
            clearTimeout(holdTimer);
            clearTimeout(safetyTimer);
            clearTimeout(landscapeTimer);
            clearTimeout(failTimer);
            document.removeEventListener('keydown', onKey);
            stopVideo();
            var finished = false;
            function done() {
              if (finished) return;
              finished = true;
              overlay.remove();
            }
            overlay.addEventListener('transitionend', done);
            setTimeout(done, FADE_MS);
          }

          function startPaper() {
            if (paperStarted || settled) return;
            paperStarted = true;
            clearTimeout(landscapeTimer);
            clearTimeout(failTimer);
            overlay.classList.remove('is-landscape');
            overlay.classList.add('is-paper');
            var fade = landscapePlayed ? PAPER_FADE_MS : 0;
            if (video) {
              try {
                video.pause();
              } catch (e) {}
              if (fade) {
                setTimeout(stopVideo, fade);
              } else {
                stopVideo();
              }
            }
            holdTimer = setTimeout(dismiss, fade + HOLD_MS);
          }

          var skip = overlay.querySelector('.site-intro__skip');
          if (skip) {
            skip.addEventListener('click', function (e) {
              e.preventDefault();
              e.stopPropagation();
              dismiss();
            });
          }
          overlay.addEventListener('click', dismiss);
          document.addEventListener('keydown', onKey);

          var images = overlay.querySelectorAll('img');
          for (var i = 0; i < images.length; i++) {
            images[i].addEventListener('error', dismiss);
          }

          safetyTimer = setTimeout(dismiss, SAFETY_MS);

          if (!video) {
            startPaper();
            return;
          }

          function scheduleLandscape(durationSec) {
            clearTimeout(landscapeTimer);
            var ms = LANDSCAPE_DEFAULT_MS;
            if (typeof durationSec === 'number' && isFinite(durationSec) && durationSec > 0) {
              var clipMs = durationSec * 1000;
              ms = clipMs <= LANDSCAPE_MAX_MS + 400 ? clipMs : LANDSCAPE_DEFAULT_MS;
              if (ms > LANDSCAPE_MAX_MS) ms = LANDSCAPE_MAX_MS;
              if (ms < 1800) ms = Math.max(clipMs, 1800);
            }
            landscapeTimer = setTimeout(startPaper, ms);
          }

          video.addEventListener('error', startPaper);
          video.addEventListener('ended', startPaper);
          video.addEventListener('playing', function () {
            landscapePlayed = true;
          });
          video.addEventListener('loadedmetadata', function () {
            scheduleLandscape(video.duration);
          });

          failTimer = setTimeout(function () {
            if (!paperStarted && video && video.readyState < 1) startPaper();
          }, VIDEO_FAIL_MS);

          scheduleLandscape();
          var playAttempt = video.play();
          if (playAttempt && playAttempt.catch) {
            playAttempt.catch(startPaper);
          }
        }

        bootIntro();
        document.addEventListener('astro:page-load', bootIntro);
      })();
    </script>
  </body>
</html>
