---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, languages, type Lang } from '../../i18n/ui';
import { INSTAGRAM_URL, INSTAGRAM_HANDLE, EMAIL, STOCKISTS } from '../../lib/site';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const linkClass =
  'text-lg text-ink border-b border-ink/30 pb-1 hover:text-ai hover:border-ai transition-colors';
---

<Layout lang={lang} title={t('contact.heading')} description={t('contact.intro')}>
  <section class="mx-auto max-w-[88rem] px-8 sm:px-14">
    <p class="label">{t('contact.heading')}</p>
    <p class="mt-12 max-w-xl text-lg leading-[2] text-ink">{t('contact.intro')}</p>

    {/* Instagram DM is how the atelier already takes enquiries, so it is the
        primary route rather than a form we would have to host. */}
    <div class="mt-16">
      <p class="note">{t('contact.dm')}</p>
      <a
        href={INSTAGRAM_URL}
        rel="me noopener"
        target="_blank"
        class:list={['mt-6 inline-block', linkClass]}
      >
        @{INSTAGRAM_HANDLE}
      </a>
      <p class="label mt-5">{t('contact.dmDetail')}</p>
    </div>

    {
      EMAIL && (
        <div class="mt-16">
          <p class="label">{t('contact.email')}</p>
          <a href={`mailto:${EMAIL}`} class:list={['mt-6 inline-block', linkClass]}>
            {EMAIL}
          </a>
        </div>
      )
    }

    {/* ---------- Stockists ---------- */}
    <div class="mt-40">
      <p class="label">{t('stockists.heading')}</p>
      <p class="mt-8 max-w-xl leading-[2] text-ink">{t('stockists.intro')}</p>

      <ul class="mt-10 space-y-4">
        {
          STOCKISTS.map((shop) => (
            <li>
              <p class="text-ink">{shop.name[lang]}</p>
              {shop.detail && <p class="label mt-1">{shop.detail[lang]}</p>}
            </li>
          ))
        }
      </ul>

      <p class="note mt-12">{t('stockists.shipping')}</p>
    </div>
  </section>
</Layout>
