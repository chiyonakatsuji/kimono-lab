---
import fs from 'node:fs';
import nodePath from 'node:path';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PieceCard from '../../components/PieceCard.astro';
import { useTranslations, path, languages, withBase, type Lang } from '../../i18n/ui';
import { STOCKISTS } from '../../lib/site';
import { getPieces } from '../../lib/facets';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const pieces = await getPieces({ available: true });

const [featured, ...rest] = pieces;

const publicDir = nodePath.join(process.cwd(), 'public');
const heroMp4Exists = fs.existsSync(nodePath.join(publicDir, 'hero-landscape.mp4'));
const heroWebmExists = fs.existsSync(nodePath.join(publicDir, 'hero-landscape.webm'));
const heroPosterExists = fs.existsSync(nodePath.join(publicDir, 'hero-landscape.jpg'));
const hasHeroVideo = heroMp4Exists || heroWebmExists;
const heroMp4Src = withBase('/hero-landscape.mp4');
const heroWebmSrc = withBase('/hero-landscape.webm');
const heroPosterSrc = withBase('/hero-landscape.jpg');
---

<Layout lang={lang} description={t('home.hero.lead')} home>
  {/* White first screen after the lockup. Landscape is under the paper
      and only shows through as the visitor scrolls. */}
  <section class="home-gate" aria-label={t('home.scroll')}>
    <div class="home-gate__track">
      <div class="home-gate__sticky">
        <div class="home-gate__media" aria-hidden="true">
          {
            heroPosterExists && (
              <img class="home-gate__poster" src={heroPosterSrc} alt="" />
            )
          }
          {
            hasHeroVideo && (
              <video
                class="home-gate__video"
                muted
                playsinline
                loop
                preload="auto"
                disablepictureinpicture
                poster={heroPosterExists ? heroPosterSrc : undefined}
              >
                {heroWebmExists && <source src={heroWebmSrc} type="video/webm" />}
                {heroMp4Exists && <source src={heroMp4Src} type="video/mp4" />}
              </video>
            )
          }
        </div>
        <div class="home-gate__paper"></div>
        <button type="button" class="home-gate__arrow" aria-label={t('home.scroll')}>
          <svg viewBox="0 0 24 12" aria-hidden="true">
            <path
              d="M2 2 L12 10 L22 2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var reduce = false;
      try {
        reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch (e) {}

      var track = document.querySelector('.home-gate__track');
      var paper = document.querySelector('.home-gate__paper');
      var media = document.querySelector('.home-gate__media');
      var arrow = document.querySelector('.home-gate__arrow');
      var video = document.querySelector('.home-gate__video');
      if (!track) return;

      if (reduce) {
        if (video) {
          try {
            video.pause();
          } catch (e) {}
          video.remove();
        }
        return;
      }

      var arrowOn = false;
      var playing = false;
      var armed = false;
      var site = false;

      function progress() {
        var span = track.offsetHeight - window.innerHeight;
        if (span <= 0) return 0;
        var y = window.scrollY || window.pageYOffset || 0;
        return Math.min(1, Math.max(0, y / span));
      }

      function tick() {
        var p = armed ? progress() : 0;
        if (paper) paper.style.opacity = String(1 - p);
        if (media) media.style.opacity = String(p);

        if (video) {
          if (p > 0.04 && !playing) {
            playing = true;
            var play = video.play();
            if (play && play.catch) play.catch(function () {});
          } else if (p <= 0.04 && playing) {
            playing = false;
            try {
              video.pause();
            } catch (e) {}
          }
        }

        var gateBottom = track.getBoundingClientRect().bottom;
        var showSite = gateBottom <= 0;
        if (showSite !== site) {
          site = showSite;
          document.body.classList.toggle('is-site', site);
        }

        if (arrow && arrowOn) {
          var visible = p < 0.1;
          arrow.style.opacity = visible ? '1' : '0';
          arrow.style.pointerEvents = visible ? 'auto' : 'none';
        }
      }

      function showArrow() {
        if (arrowOn || !arrow) return;
        arrowOn = true;
        arrow.classList.add('is-ready');
        tick();
      }

      function arm() {
        if (armed) return;
        armed = true;
        window.scrollTo(0, 0);
        tick();
        window.setTimeout(showArrow, 200);
      }

      function revealLandscape() {
        var y = Math.max(0, track.offsetHeight - window.innerHeight);
        window.scrollTo({ top: y, behavior: 'smooth' });
      }

      if (arrow) {
        arrow.addEventListener('click', function (e) {
          e.preventDefault();
          revealLandscape();
        });
      }

      window.addEventListener('scroll', tick, { passive: true });
      window.addEventListener('resize', tick);

      document.addEventListener('kimono-lab:intro-gone', arm);
      if (!document.getElementById('site-intro')) {
        arm();
      }
    })();
  </script>

  <div id="home-site" class="frame pt-44 sm:pt-56 lg:pt-72 pb-4">
    <h1 class="home-site__lead">{t('home.hero.lead')}</h1>
  </div>
  {
    featured && (
      <section class="frame pt-36 sm:pt-48 lg:pt-60">
        <a href={path(lang, 'pieces', featured.id)} class="group block">
          <Image
            src={featured.data.photo}
            alt={featured.data[lang].alt}
            widths={[720, 1100, 1600]}
            sizes="(min-width: 1024px) 48vw, 100vw"
            class="w-full max-w-2xl sm:max-w-3xl h-auto bg-paper-dim"
          />
          <div class="mt-12 flex flex-wrap items-baseline gap-x-10 gap-y-3">
            <h2 class="text-base text-sumi group-hover:text-ai transition-colors">
              {featured.data[lang].name}
            </h2>
            {featured.data.provenance && (
              <>
                <p class="label">{featured.data.provenance.cloth[lang]}</p>
                <p class="label">{featured.data.provenance.motif[lang]}</p>
              </>
            )}
          </div>
        </a>
      </section>
    )
  }

  {/* ---------- Remaining pieces ---------- */}
  {
    rest.length > 0 && (
      <section class="frame pt-48 sm:pt-56 lg:pt-64">
        <div class="piece-grid">
          {rest.slice(0, 6).map((piece) => (
            <PieceCard piece={piece} lang={lang} />
          ))}
        </div>
      </section>
    )
  }

  {/* ---------- Atelier ---------- */}
  <section class="frame pt-48 sm:pt-56 lg:pt-64">
    <p class="label">{t('home.about.heading')}</p>
    <p class="mt-10 max-w-md text-lg leading-[2.15] text-ink">
      {
        lang === 'ja'
          ? '《ここにアトリエの紹介文が入ります。お母様の言葉に差し替えてください。》'
          : '(Placeholder — a short introduction to the atelier goes here, in your mother’s words.)'
      }
    </p>
    <div class="mt-14 flex gap-12">
      <a href={path(lang, 'about')} class="label hover:text-sumi transition-colors">
        {t('home.about.more')}
      </a>
      <a href={path(lang, 'pieces')} class="label hover:text-sumi transition-colors">
        {t('home.pieces.viewAll')}
      </a>
    </div>
  </section>

  {/* ---------- Stockists: the hotel boutiques are a trust signal, so they
       belong on the homepage rather than buried on Contact. ---------- */}
  <section class="frame pt-48 sm:pt-56 lg:pt-64">
    <p class="label">{t('stockists.heading')}</p>
    <ul class="mt-10 flex flex-wrap gap-x-16 gap-y-4">
      {STOCKISTS.map((shop) => <li class="text-ink">{shop.name[lang]}</li>)}
    </ul>
    <p class="note mt-12">{t('stockists.shipping')}</p>
    <a
      href={path(lang, 'contact')}
      class="label mt-14 inline-block hover:text-sumi transition-colors"
    >
      {t('nav.contact')}
    </a>
  </section>
</Layout>
