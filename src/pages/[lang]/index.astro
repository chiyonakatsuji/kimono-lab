---
import fs from 'node:fs';
import nodePath from 'node:path';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PieceCard from '../../components/PieceCard.astro';
import { useTranslations, path, languages, withBase, type Lang } from '../../i18n/ui';
import { STOCKISTS } from '../../lib/site';
import wordmark from '../../assets/logo-wordmark.png';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const pieces = (await getCollection('pieces', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const [featured, ...rest] = pieces;

const publicDir = nodePath.join(process.cwd(), 'public');
const heroMp4Exists = fs.existsSync(nodePath.join(publicDir, 'hero-landscape.mp4'));
const heroWebmExists = fs.existsSync(nodePath.join(publicDir, 'hero-landscape.webm'));
const heroPosterExists = fs.existsSync(nodePath.join(publicDir, 'hero-landscape.jpg'));
const hasHeroVideo = heroMp4Exists || heroWebmExists;
const heroMp4Src = withBase('/hero-landscape.mp4');
const heroWebmSrc = withBase('/hero-landscape.webm');
const heroPosterSrc = withBase('/hero-landscape.jpg');
---

<Layout lang={lang} description={t('home.hero.lead')} home>
  {/* Full-viewport scenery after the paper intro — looping ambient hero,
      not a preloader. Piece pages stay gallery-first. */}
  <section class="home-hero">
    <div class="home-hero__media" aria-hidden="true">
      {
        heroPosterExists && (
          <img class="home-hero__poster" src={heroPosterSrc} alt="" />
        )
      }
      {
        hasHeroVideo && (
          <video
            class="home-hero__video"
            muted
            playsinline
            loop
            autoplay
            preload="auto"
            disablepictureinpicture
            poster={heroPosterExists ? heroPosterSrc : undefined}
          >
            {heroWebmExists && <source src={heroWebmSrc} type="video/webm" />}
            {heroMp4Exists && <source src={heroMp4Src} type="video/mp4" />}
          </video>
        )
      }
    </div>
    <div class="home-hero__overlay">
      <Image
        src={wordmark}
        alt=""
        widths={[320, 640]}
        sizes="(min-width: 640px) 12rem, 10rem"
        class="home-hero__wordmark"
        loading="eager"
        aria-hidden="true"
      />
      <h1 class="home-hero__lead">{t('home.hero.lead')}</h1>
    </div>
  </section>

  <script is:inline>
    (function () {
      var reduce = false;
      try {
        reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch (e) {}
      if (!reduce) return;
      var video = document.querySelector('.home-hero__video');
      if (!video) return;
      try {
        video.pause();
      } catch (e) {}
      video.removeAttribute('autoplay');
      if (document.querySelector('.home-hero__poster')) {
        try {
          video.removeAttribute('src');
          var sources = video.querySelectorAll('source');
          for (var i = 0; i < sources.length; i++) sources[i].remove();
          video.load();
        } catch (e) {}
        video.remove();
      }
    })();
  </script>

  {/* ---------- The photograph, given room ---------- */}
  {
    featured && (
      <section class="mx-auto max-w-[88rem] px-8 sm:px-14 pt-24 sm:pt-32">
        <a href={path(lang, 'pieces', featured.id)} class="group block">
          <Image
            src={featured.data.photo}
            alt={featured.data[lang].alt}
            widths={[720, 1100, 1600]}
            sizes="(min-width: 1024px) 62vw, 100vw"
            class="w-full max-w-3xl h-auto bg-paper-dim"
          />
          <div class="mt-8 flex flex-wrap items-baseline gap-x-8 gap-y-2">
            <h2 class="text-base text-sumi group-hover:text-ai transition-colors">
              {featured.data[lang].name}
            </h2>
            {featured.data.provenance && (
              <>
                <p class="label">{featured.data.provenance.cloth[lang]}</p>
                <p class="label">{featured.data.provenance.motif[lang]}</p>
              </>
            )}
          </div>
        </a>
      </section>
    )
  }

  {/* ---------- Remaining pieces ---------- */}
  {
    rest.length > 0 && (
      <section class="mx-auto max-w-[88rem] px-8 sm:px-14 pt-40">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-24">
          {rest.slice(0, 6).map((piece) => (
            <PieceCard piece={piece} lang={lang} />
          ))}
        </div>
      </section>
    )
  }

  {/* ---------- Atelier ---------- */}
  <section class="mx-auto max-w-[88rem] px-8 sm:px-14 pt-40">
    <p class="label">{t('home.about.heading')}</p>
    <p class="mt-8 max-w-xl text-lg leading-[2] text-ink">
      {
        lang === 'ja'
          ? '《ここにアトリエの紹介文が入ります。お母様の言葉に差し替えてください。》'
          : '(Placeholder — a short introduction to the atelier goes here, in your mother’s words.)'
      }
    </p>
    <div class="mt-10 flex gap-10">
      <a href={path(lang, 'about')} class="label hover:text-sumi transition-colors">
        {t('home.about.more')}
      </a>
      <a href={path(lang, 'pieces')} class="label hover:text-sumi transition-colors">
        {t('home.pieces.viewAll')}
      </a>
    </div>
  </section>

  {/* ---------- Stockists: the hotel boutiques are a trust signal, so they
       belong on the homepage rather than buried on Contact. ---------- */}
  <section class="mx-auto max-w-[88rem] px-8 sm:px-14 pt-40">
    <p class="label">{t('stockists.heading')}</p>
    <ul class="mt-8 flex flex-wrap gap-x-12 gap-y-3">
      {STOCKISTS.map((shop) => <li class="text-ink">{shop.name[lang]}</li>)}
    </ul>
    <p class="note mt-8">{t('stockists.shipping')}</p>
    <a
      href={path(lang, 'contact')}
      class="label mt-10 inline-block hover:text-sumi transition-colors"
    >
      {t('nav.contact')}
    </a>
  </section>
</Layout>
