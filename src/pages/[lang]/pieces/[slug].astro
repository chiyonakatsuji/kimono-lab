---
import Layout from '../../../layouts/Layout.astro';
import PieceCard from '../../../components/PieceCard.astro';
import PiecePhotos from '../../../components/PiecePhotos.astro';
import { getPieces, relatedTo, groupBy } from '../../../lib/facets';
import { useTranslations, path, languages, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const pieces = await getPieces();
  return (Object.keys(languages) as Lang[]).flatMap((lang) =>
    pieces.map((piece) => ({
      params: { lang, slug: piece.id },
      props: { piece, pieces },
    })),
  );
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { piece, pieces } = Astro.props;

const text = piece.data[lang];
const prov = piece.data.provenance;

// Authored as plain paragraphs separated by blank lines.
const paragraphs = text.story.trim().split(/\n\s*\n/);

const relatedPool = pieces.filter((p) => p.data.available === piece.data.available);
const sameCloth = relatedTo(piece, relatedPool, 'cloth');
const sameMotif = relatedTo(piece, relatedPool, 'motif');

const catalogue = pieces.filter((p) => p.data.available !== false);
const clothPages = new Set(groupBy(catalogue, 'cloth').map((g) => g.key));
const motifPages = new Set(groupBy(catalogue, 'motif').map((g) => g.key));

// Provenance rows. Cloth and motif link out to everything sharing them, unless
// the value is the sync script's "unspecified" placeholder. Provenance is
// absent entirely on some Instagram-synced pieces. Facet URLs only exist for
// available pieces, so sold archive entries do not link to empty / 404 pages.
const linkable = (key: string) => key !== 'unspecified';
const rows = prov
  ? [
      {
        label: t('piece.cloth'),
        value: prov.cloth[lang],
        href: linkable(prov.clothKey) && clothPages.has(prov.clothKey)
          ? path(lang, 'pieces', 'cloth', prov.clothKey)
          : null,
      },
      {
        label: t('piece.motif'),
        value: prov.motif[lang],
        href: linkable(prov.motifKey) && motifPages.has(prov.motifKey)
          ? path(lang, 'pieces', 'motif', prov.motifKey)
          : null,
      },
      ...(prov.era ? [{ label: t('piece.era'), value: prov.era[lang], href: null }] : []),
      ...(prov.region ? [{ label: t('piece.region'), value: prov.region[lang], href: null }] : []),
      ...(prov.meaning ? [{ label: t('piece.meaning'), value: prov.meaning[lang], href: null }] : []),
    ]
  : [];
---

<Layout lang={lang} title={text.name} description={prov?.cloth[lang] ?? text.alt}>
  <article class="frame">
    <a
      href={piece.data.available === false ? path(lang, 'about') : path(lang, 'pieces')}
      class="label hover:text-sumi transition-colors"
    >
      ← {piece.data.available === false ? t('nav.about') : t('piece.back')}
    </a>

    <div class="mt-16 grid lg:grid-cols-[1.05fr_1fr] gap-20 lg:gap-36 items-start">
      {/* ---------- Photographs ---------- */}
      <div>
        <PiecePhotos
          lang={lang}
          alt={text.alt}
          photo={piece.data.photo}
          gallery={piece.data.gallery}
        />
      </div>

      {/* ---------- Text ---------- */}
      <div class="lg:sticky lg:top-14">
        <p class="label">{t('piece.oneOfAKind')}</p>
        <h1 class="mt-8 text-2xl sm:text-3xl leading-[1.75] text-sumi">{text.name}</h1>

        {/* Provenance — the organising idea of the site. */}
        <dl class="mt-16 space-y-6">
          {
            rows.map((row: { label: string; value: string; href: string | null }) => (
              <div class="grid grid-cols-[5.5rem_1fr] gap-6 items-baseline">
                <dt class="label">{row.label}</dt>
                <dd class="text-ink leading-[1.9]">
                  {row.href ? (
                    <a href={row.href} class="hover:text-ai transition-colors">
                      {row.value}
                    </a>
                  ) : (
                    row.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-16 space-y-8 leading-[2.15] text-ink">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <div class="mt-20">
          <p class="label">
            {piece.data.available ? t('piece.status.available') : t('piece.status.sold')}
          </p>
          {
            piece.data.available && (
              <a
                href={path(lang, 'contact')}
                class="mt-6 inline-block text-ink border-b border-ink/30 pb-1 hover:text-ai hover:border-ai transition-colors"
              >
                {t('piece.inquire')}
              </a>
            )
          }

          {/* Synced pieces credit the original post. */}
          {
            piece.data.permalink && (
              <p class="mt-8">
                <a
                  href={piece.data.permalink}
                  rel="noopener"
                  target="_blank"
                  class="label hover:text-sumi transition-colors"
                >
                  {t('piece.viewOnInstagram')}
                </a>
              </p>
            )
          }
        </div>
      </div>
    </div>

    {/* ---------- Pieces sharing provenance ---------- */}
    {
      [
        { heading: t('piece.seeAlsoCloth'), items: sameCloth },
        { heading: t('piece.seeAlsoMotif'), items: sameMotif },
      ]
        .filter((section) => section.items.length > 0)
        .map((section) => (
          <section class="pt-48 sm:pt-56 lg:pt-64">
            <p class="label">{section.heading}</p>
            <div class="mt-14 piece-grid">
              {section.items.slice(0, 3).map((p) => (
                <PieceCard piece={p} lang={lang} />
              ))}
            </div>
          </section>
        ))
    }
  </article>
</Layout>
