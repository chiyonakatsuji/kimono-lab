---
import Layout from '../../layouts/Layout.astro';
import PieceCard from '../../components/PieceCard.astro';
import { useTranslations, path, languages, type Lang } from '../../i18n/ui';
import { getPieces } from '../../lib/facets';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const sold = await getPieces({ available: false });

// PLACEHOLDER COPY — to be replaced with the atelier's own words.
const body = {
  ja: [
    'たんすの奥で着られなくなった着物を、もう一度着られるかたちに仕立て直しています。',
    '一枚の着物からとれる生地には限りがあります。柄の出方も一枚ごとに違うため、同じドレスは二度作れません。裁つ前に生地を広げ、どの文様をどこに置くかを決めてから、裁ちはじめます。',
    'お手持ちの着物のお仕立て直しも承っています。',
  ],
  en: [
    'Kimono that can no longer be worn are taken apart and remade into something wearable again.',
    'There is only so much cloth in a single kimono, and the pattern falls differently on every one, so no dress can be made twice. The cloth is spread out first, and where each motif will sit is decided before any cutting begins.',
    'Remaking a kimono you already own is also possible — please ask.',
  ],
}[lang];
---

<Layout lang={lang} title={t('nav.about')} description={body[0]}>
  <section class="frame">
    <p class="label">{t('nav.about')}</p>

    <div class="mt-16 max-w-md space-y-10 text-lg leading-[2.15] text-ink">
      {body.map((p) => <p>{p}</p>)}
    </div>

    <div class="mt-20 flex gap-12">
      <a href={path(lang, 'contact')} class="label hover:text-sumi transition-colors">
        {t('nav.contact')}
      </a>
      <a href={path(lang, 'pieces')} class="label hover:text-sumi transition-colors">
        {t('nav.pieces')}
      </a>
    </div>
  </section>

  {
    sold.length > 0 && (
      <section class="frame pt-48 sm:pt-56 lg:pt-64">
        <p class="label">{t('about.archive')}</p>
        <p class="note mt-8 max-w-md">{t('about.archiveLead')}</p>
        <div class="mt-16 piece-grid">
          {sold.map((piece, i) => (
            <PieceCard piece={piece} lang={lang} eager={i === 0} />
          ))}
        </div>
      </section>
    )
  }
</Layout>
